# Deployment selection and optional configuration directory. An unset APP_ENV means production.
APP_ENV=local
CONFIG_DIR=config
# Evidence packing is configured in YAML with context.tokenizer_encoding and context.tokenizer_verified_for.

# Secrets and external provider endpoints. No application prefix is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
MONGODB_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Trusted-gateway authentication, trace access, and the telemetry HMAC key.
# Production refuses to start with these placeholder values.
AUTH_SHARED_TOKEN=replace-this-auth-token
DEBUG_TOKEN=replace-this-debug-token
TELEMETRY_HASH_KEY=replace-this-telemetry-key
